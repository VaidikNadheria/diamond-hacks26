# Copy to .env.local. Fill in your own development credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
BROWSER_USE_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=
# Use an address on your verified Resend domain, or an allowed test sender.
RESEND_FROM_EMAIL=Belfort Tips <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000
MIN_SCOUT_SCORE=40

# Only needed for the optional migration scripts.
# Use the PostgreSQL connection string from Supabase, with its database password.
# A Supabase API/service-role key is not a PostgreSQL password.
DATABASE_URL=
